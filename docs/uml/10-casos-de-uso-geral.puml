@startuml Casos de Uso - Visão Geral da Fachada CAGEPA

!define USUARIO_COLOR #E1F5FF
!define SISTEMA_COLOR #FFF3E0
!define EXTERNO_COLOR #E8F5E9

actor "Integrador\n(CLI/API/UI)" as Integrador
actor "Admin\n(Sistema)" as Admin
actor "Sistema Externo\nResend (Email)" as ResendAPI
actor "OCR\nTesseract" as Tesseract
actor "Banco de Dados\nPostgreSQL" as BD

rectangle "Fachada CAGEPA" {

  ' Casos de Uso de Autenticação
  usecase "UC01: Autenticar\n(Login Admin)" as UC01
  usecase "UC02: Validar Token\n(Verificar JWT)" as UC02
  usecase "UC03: Criar Admin\n(Novo Usuário)" as UC03

  ' Casos de Uso de Gestão de Clientes
  usecase "UC04: Registrar Cliente PF" as UC04
  usecase "UC05: Registrar Cliente PJ" as UC05
  usecase "UC06: Atualizar Cliente" as UC06
  usecase "UC07: Listar Clientes" as UC07
  usecase "UC08: Obter Detalhes Cliente" as UC08

  ' Casos de Uso de Gestão de Hidrômetros
  usecase "UC09: Registrar Hidrômetro" as UC09
  usecase "UC10: Listar Hidrômetros" as UC10
  usecase "UC11: Atualizar Status\nHidrômetro" as UC11

  ' Casos de Uso de Leitura de Imagens
  usecase "UC12: Processar Imagem\nHidrômetro" as UC12
  usecase "UC13: Extrair Valor\nvia OCR" as UC13
  usecase "UC14: Registrar Leitura" as UC14

  ' Casos de Uso de Consumo
  usecase "UC15: Calcular Consumo\nDiário" as UC15
  usecase "UC16: Calcular Consumo\nSemanal" as UC16
  usecase "UC17: Calcular Consumo\nMensal" as UC17
  usecase "UC18: Calcular Consumo\nAnual" as UC18
  usecase "UC19: Consumo por\nHidrômetro" as UC19

  ' Casos de Uso de Notificações
  usecase "UC20: Verificar Consumo\nAlto (>70%)" as UC20
  usecase "UC21: Enviar Email\nNotificação" as UC21
  usecase "UC22: Listar Notificações\nEnviadas" as UC22

  ' Casos de Uso de Auditoria
  usecase "UC23: Registrar\nOperação" as UC23
  usecase "UC24: Listar Histórico\nAuditoria" as UC24

  ' Casos de Uso de Configuração
  usecase "UC25: Configurar\nDiretório Imagens" as UC25
  usecase "UC26: Configurar\nTesseract" as UC26
  usecase "UC27: Configurar\nChaves API" as UC27
}

' Relações do Integrador
Integrador --> UC01
Integrador --> UC02
Integrador --> UC03
Integrador --> UC04
Integrador --> UC05
Integrador --> UC06
Integrador --> UC07
Integrador --> UC08
Integrador --> UC09
Integrador --> UC10
Integrador --> UC11
Integrador --> UC12
Integrador --> UC15
Integrador --> UC16
Integrador --> UC17
Integrador --> UC18
Integrador --> UC19
Integrador --> UC20
Integrador --> UC22
Integrador --> UC24

' Relações do Admin
Admin --> UC03
Admin --> UC25
Admin --> UC26
Admin --> UC27

' Inclusões (<<include>>)
UC01 --> UC02 : <<include>>
UC04 --> UC02 : <<include>>
UC05 --> UC02 : <<include>>
UC06 --> UC02 : <<include>>
UC07 --> UC02 : <<include>>
UC08 --> UC02 : <<include>>
UC09 --> UC02 : <<include>>
UC10 --> UC02 : <<include>>
UC11 --> UC02 : <<include>>
UC12 --> UC02 : <<include>>
UC15 --> UC02 : <<include>>
UC16 --> UC02 : <<include>>
UC17 --> UC02 : <<include>>
UC18 --> UC02 : <<include>>
UC19 --> UC02 : <<include>>
UC20 --> UC02 : <<include>>
UC22 --> UC02 : <<include>>
UC24 --> UC02 : <<include>>

UC12 --> UC13 : <<include>>
UC12 --> UC14 : <<include>>
UC20 --> UC21 : <<include>>
UC20 --> UC23 : <<include>>

' Relacionamento com sistemas externos
UC13 --> Tesseract : usa
UC21 --> ResendAPI : usa
UC14 --> BD : persiste
UC23 --> BD : persiste

note right of UC01
  Token JWT é retornado
  e utilizado em todas
  as operações subsequentes
end note

note right of UC12
  Monitora diretório de imagens
  Detecta arquivo novo
  Processa via Tesseract OCR
end note

note right of UC20
  Verifica todos os hidrômetros
  Acionado automaticamente
  ou sob demanda
end note

@enduml

